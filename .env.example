# Fashion Multimodal Retrieval Explorer - Environment Configuration (.env)

# Direktori Utama Proyek (Cukup isi ini saja, semua subdirektori otomatis menyesuaikan)
# Kosongkan jika ingin auto-detect otomatis berdasarkan lokasi folder saat ini:
PROJECT_ROOT=

# Konfigurasi Model & Retrieval CLIP
CLIP_MODEL_NAME=openai/clip-vit-base-patch32
EMBEDDING_DIM=512
BATCH_SIZE=32
RANDOM_SEED=42

# Konfigurasi Web Server
HOST=0.0.0.0
PORT=8000
RELOAD=true
